    <!-- Static rules -->
    <string name="rule_hardcoded_secret_summary">Möglicher fest codierter Zugangsschlüssel.</string>
    <string name="rule_hardcoded_secret_detail">Ein geheimnisartiger Wert wird einer Variable oder Eigenschaft zugewiesen. In sicheren Speicher / Umgebung verschieben und rotieren.</string>
    <string name="rule_sql_injection_summary">Mögliche SQL-Injection durch String-Verkettung.</string>
    <string name="rule_sql_injection_detail">Ein SQL-Statement wird aus dynamischen Werten zusammengesetzt. Parametrisierte Abfragen / Prepared Statements verwenden.</string>
    <string name="rule_command_injection_summary">Mögliche Command-Injection.</string>
    <string name="rule_command_injection_detail">Ein Shell-/Systembefehl wird aus dynamischer Eingabe gebaut. Eingaben validieren und die Shell möglichst vermeiden.</string>
    <string name="rule_code_eval_summary">Dynamischer Code / unsichere Deserialisierung.</string>
    <string name="rule_code_eval_detail">Das Ausführen von Code oder Deserialisieren nicht vertrauenswürdiger Daten kann zu Remote-Code-Ausführung führen. Sichere Parser verwenden und eval vermeiden.</string>
    <string name="rule_tls_disable_summary">TLS-Prüfung deaktiviert.</string>
    <string name="rule_tls_disable_detail">Zertifikats- oder Hostnamenprüfung wird umgangen, was Man-in-the-Middle-Angriffe ermöglicht. Diese Überschreibung entfernen.</string>
    <string name="rule_xss_summary">Potenzieller XSS-Sink.</string>
    <string name="rule_xss_detail">Nicht vertrauenswürdige Daten im DOM können Skripte ausführen. Eingaben bereinigen oder sichere Text-APIs verwenden.</string>
    <string name="rule_weak_crypto_summary">Schwacher Krypto-Algorithmus.</string>
    <string name="rule_weak_crypto_detail">MD5/SHA-1/DES/RC4 sind für Sicherheitszwecke gebrochen. SHA-256+ und AES-GCM verwenden.</string>
    <string name="rule_insecure_random_summary">Nicht-kryptografische Zufälligkeit.</string>
    <string name="rule_insecure_random_detail">Zufallswerte für Tokens oder Sicherheitsentscheidungen sollten aus einer kryptografisch sicheren Quelle stammen.</string>
    <string name="rule_cleartext_http_summary">Klartext-HTTP-Endpunkt.</string>
    <string name="rule_cleartext_http_detail">Verkehr über http:// ist unverschlüsselt. Bevorzugen Sie https:// zum Schutz der Datenübertragung.</string>
    <string name="rule_empty_catch_summary">Leerer catch-Block verschluckt Fehler.</string>
    <string name="rule_empty_catch_detail">Ausnahmen stillschweigend zu ignorieren verbirgt Fehler. Fehler explizit protokollieren oder behandeln.</string>
    <string name="rule_todo_marker_summary">Ungeklärter TODO/FIXME.</string>
    <string name="rule_todo_marker_detail">Marker für offene Arbeit gefunden; prüfen, ob er unvollständiges oder unsicheres Verhalten darstellt.</string>
    <string name="rule_debug_output_summary">Debug-Ausgabe im Code.</string>
    <string name="rule_debug_output_detail">Übrig gebliebenes Debug-Logging kann Informationen preisgeben oder die Performance in Produktion beeinträchtigen.</string>
    <string name="rule_insecure_cors_summary">Permissive CORS-Richtlinie.</string>
    <string name="rule_insecure_cors_detail">Eine Wildcard-CORS-Origin erlaubt jeder Seite, Antworten zu lesen. Auf vertrauenswürdige Ursprünge beschränken.</string>
