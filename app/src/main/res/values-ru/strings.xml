    <!-- Static rules -->
    <string name="rule_hardcoded_secret_summary">Возможны захардкоженные учётные данные.</string>
    <string name="rule_hardcoded_secret_detail">Значение, похожее на секрет, присвоено переменной или свойству. Перенесите его в защищённое хранилище/переменные окружения и смените.</string>
    <string name="rule_sql_injection_summary">Возможна SQL-инъекция через конкатенацию строк.</string>
    <string name="rule_sql_injection_detail">SQL-запрос собирается из динамических значений. Используйте параметризованные запросы / prepared statements.</string>
    <string name="rule_command_injection_summary">Возможна инъекция команд.</string>
    <string name="rule_command_injection_detail">Команда оболочки/системы строится из динамического ввода. Проверяйте ввод и по возможности избегайте оболочки.</string>
    <string name="rule_code_eval_summary">Динамический код / небезопасная десериализация.</string>
    <string name="rule_code_eval_detail">Выполнение кода или десериализация недоверенных данных может привести к удалённому выполнению кода. Используйте безопасные парсеры и избегайте eval.</string>
    <string name="rule_tls_disable_summary">Проверка TLS отключена.</string>
    <string name="rule_tls_disable_detail">Проверка сертификата или имени хоста обходится, что открывает атаки «человек посередине». Уберите это переопределение.</string>
    <string name="rule_xss_summary">Потенциальный сток XSS.</string>
    <string name="rule_xss_detail">Недоверенные данные, записанные в DOM, могут выполнить скрипты. Санитизируйте ввод или используйте безопасные текстовые API.</string>
    <string name="rule_weak_crypto_summary">Слабый криптографический алгоритм.</string>
    <string name="rule_weak_crypto_detail">MD5/SHA-1/DES/RC4 непригодны для безопасности. Используйте SHA-256+ и AES-GCM.</string>
    <string name="rule_insecure_random_summary">Небезопасная случайность.</string>
    <string name="rule_insecure_random_detail">Случайные значения для токенов и решений безопасности должны браться из криптографически стойкого источника.</string>
    <string name="rule_cleartext_http_summary">Эндпоинт по незашифрованному HTTP.</string>
    <string name="rule_cleartext_http_detail">Трафик по http:// не шифруется. Предпочитайте https:// для защиты данных в пути.</string>
    <string name="rule_empty_catch_summary">Пустой блок catch проглатывает ошибки.</string>
    <string name="rule_empty_catch_detail">Молчаливое игнорирование исключений скрывает сбои. Логируйте или обрабатывайте ошибку явно.</string>
    <string name="rule_todo_marker_summary">Незакрытый TODO/FIXME.</string>
    <string name="rule_todo_marker_detail">Найдена метка незавершённой работы; проверьте, не означает ли она неполное или небезопасное поведение.</string>
    <string name="rule_debug_output_summary">Отладочный вывод в коде.</string>
    <string name="rule_debug_output_detail">Оставленное отладочное логирование может раскрыть информацию или снизить производительность в проде.</string>
    <string name="rule_insecure_cors_summary">Разрешительная политика CORS.</string>
    <string name="rule_insecure_cors_detail">Источник CORS с подстановочным знаком позволяет любому сайту читать ответы. Ограничьте доверенными источниками.</string>
    <string name="rule_clean_summary">Статические правила проблем не нашли.</string>
    <string name="rule_clean_detail">Известных антипаттернов в этом фрагменте не найдено. Включите LLM-проверку для более глубокой смысловой оценки.</string>
